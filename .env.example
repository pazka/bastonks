# bastonks — environment. Copy to bastonks.env (chmod 600), never commit the real file.
# The defaults below are the hosh.it box values: copying this file unchanged is enough, then the
# OWNER fills the secrets (never the agent). `hosh-deploy register` checks the names on the `# required:` line
# are non-empty (values are never printed).
# required: TRELLO_KEY TRELLO_TOKEN TRELLO_BOARD_ID
# (space-separated variable names that must be non-empty, e.g. "APP_ADMIN_PASSWORD_HASH")

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/bastonks:v1.0.0'
APP_BIND='127.0.0.1:9130'

# --- app ---
# Behind Traefik: X-Forwarded-For is trustworthy only from the docker gateway / loopback.
APP_TRUSTED_PROXIES='127.0.0.0/8,::1/128,172.16.0.0/12'
APP_BASE_URL='https://bastonks.hosh.it'
APP_DATA_DIR='/data'
# How long a visit waits for Trello before the last good snapshot is served (ms), and the minimum gap
# between two board fetches (s) — visits closer than that share the last fetch (Trello rate limit).
APP_FETCH_TIMEOUT_MS='3000'
APP_MIN_REFETCH_S='10'
APP_LOG_LEVEL='info'

# --- secrets (OWNER only, via scripts/set-trello.sh; never printed, never committed) ---
# Read-only Trello API key + token, and the id of the thesis board.
TRELLO_KEY=''
TRELLO_TOKEN=''
TRELLO_BOARD_ID=''
