{
  "version": "0.1.0",
  "lock": {
    "frozen": true
  },
  "minimumDependencyAge": "P7D",
  "nodeModulesDir": "none",
  "allowScripts": false,
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/http": "jsr:@std/http@1.1.4",
    "three": "npm:three@0.186.1",
    "@types/three": "npm:@types/three@0.186.0",
    "playwright-core": "npm:playwright-core@1.64.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "fmt": {
    "lineWidth": 110,
    "include": [
      "src/",
      "tests/",
      "scripts/"
    ],
    "exclude": [
      "src/server/assets.gen.ts"
    ]
  },
  "lint": {
    "exclude": [
      "dist/",
      "src/server/assets.gen.ts"
    ]
  },
  "exclude": [
    "dist/",
    "data/"
  ]
}
